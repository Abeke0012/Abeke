# ---------------------------------------------------------------------------
# WhatsApp AI Agent — copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# HTTP port for the Express server (webhook + /health)
PORT=3000

# How to connect to WhatsApp:
#   cloud = official WhatsApp Cloud API via webhook (recommended for production)
#   webjs = whatsapp-web.js, log in by scanning a QR code in the terminal
WHATSAPP_MODE=cloud

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Facts the agent is allowed to use in replies (it will NOT invent anything else).
# Keep it on one line, or wrap it in double quotes to use \n line breaks.
BUSINESS_CONTEXT="Acme Coffee Roasters. Open Mon-Sat 9:00-18:00. We sell whole-bean coffee (250g from $12) and ship within the EU in 2-4 days. Orders: https://acme.example/shop"

# --- Excel log ---------------------------------------------------------------
EXCEL_FILE_PATH=./whatsapp_leads.xlsx

# Messages from one sender arriving within this window are merged into one reply.
MESSAGE_BATCH_WINDOW_MS=3000

# Loop guard: the agent's own number(s), comma separated, digits with country code.
# (Also detected automatically at runtime; set it explicitly to be safe.)
AGENT_PHONE_NUMBER=

# --- WHATSAPP_MODE=cloud (Meta WhatsApp Cloud API) ---------------------------
# Permanent System User access token with whatsapp_business_messaging permission
WHATSAPP_TOKEN=
# "Phone number ID" from App Dashboard -> WhatsApp -> API Setup (not the phone number itself)
PHONE_NUMBER_ID=
# Any random string; paste the same value into the webhook configuration in Meta
WEBHOOK_VERIFY_TOKEN=
# App Dashboard -> App settings -> Basic -> App secret (used to verify webhook signatures)
APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- WHATSAPP_MODE=webjs (whatsapp-web.js) -----------------------------------
# Folder where the logged-in session is persisted (scan the QR code only once).
# Delete it to log out or link a different phone.
WWEBJS_SESSION_DIR=./.wwebjs_auth
